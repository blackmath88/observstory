{
  "title": "Project Observatory",
  "window_hours": 48,
  "max_commits": 60,
  "max_pull_requests": 40,
  "max_issues": 40,
  "lanes": [
    {
      "id": "intent",
      "label": "Intent",
      "description": "Problem framing, research, architecture and decisions",
      "paths": ["README.md", "docs/", "research/", "ARCHITECTURE.md", "DECISIONS.md"]
    },
    {
      "id": "build",
      "label": "Build",
      "description": "Product implementation",
      "paths": ["src/", "app/", "lib/", "packages/", "public/"]
    },
    {
      "id": "verify",
      "label": "Verify",
      "description": "Tests, evaluations and evidence",
      "paths": ["test/", "tests/", "evals/", "fixtures/"]
    },
    {
      "id": "ship",
      "label": "Ship",
      "description": "Automation, deployment and runtime",
      "paths": [".github/", "Dockerfile", "docker-compose", "deploy/", "infra/"]
    }
  ]
}
