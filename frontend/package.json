{
  "name": "@observstory/frontend",
  "private": true,
  "type": "module",
  "description": "Observatory frontend: a static TanStack Start app that renders an Observstory snapshot (typed, opt-in; the Python renderer stays available).",
  "scripts": {
    "dev": "vite dev --port 4317",
    "build": "vite build",
    "preview": "vite preview --port 4318",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@primer/octicons-react": "19.42.0",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.4",
    "ajv": "8.20.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
