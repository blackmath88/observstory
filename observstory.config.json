{
  "title": "Observstory / self-observation",
  "window_hours": 72,
  "lanes": [
    {
      "id": "model",
      "label": "Model",
      "description": "Problem, product boundary and decisions",
      "paths": ["README.md", "ARCHITECTURE.md", "ROADMAP.md", "DECISIONS.md", "CLAUDE_DOUBLE_DIAMOND.md", "docs/"]
    },
    {
      "id": "engine",
      "label": "Engine",
      "description": "Collection, derivation and signals",
      "paths": ["src/", "scripts/"]
    },
    {
      "id": "evidence",
      "label": "Evidence",
      "description": "Tests, fixtures and prototypes that prove or falsify signals",
      "paths": ["tests/", "fixtures/", "prototypes/"]
    },
    {
      "id": "integration",
      "label": "Integration",
      "description": "Install surface and repository automation",
      "paths": ["action.yml", ".github/"]
    },
    {
      "id": "contract",
      "label": "Contract",
      "description": "Configuration and typed state contracts",
      "paths": ["observstory.config", "schema/"]
    }
  ]
}
