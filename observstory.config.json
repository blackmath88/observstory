{
  "title": "Observstory / self-observation",
  "window_hours": 48,
  "max_commits": 60,
  "max_pull_requests": 40,
  "max_issues": 40,
  "lanes": [
    {
      "id": "model",
      "label": "Model",
      "description": "Architecture, product boundaries and project semantics",
      "paths": ["README.md", "ARCHITECTURE.md", "ROADMAP.md", "docs/"]
    },
    {
      "id": "engine",
      "label": "Engine",
      "description": "Collection, normalization and derived signals",
      "paths": ["scripts/"]
    },
    {
      "id": "integration",
      "label": "Integration",
      "description": "Install surface and repository automation",
      "paths": ["action.yml", ".github/"]
    },
    {
      "id": "contract",
      "label": "Contract",
      "description": "Configuration and typed state contracts",
      "paths": ["observstory.config", "schema/"]
    }
  ]
}
