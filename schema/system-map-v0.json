{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/blackmath88/observstory/schema/system-map-v0.json",
  "title": "Observstory System Map v0",
  "description": "A declared, evidence-aware semantic architecture model. No coordinates: layout belongs to renderers. This model is separate from observstory.snapshot/v1 and must never be mistaken for observed repository truth.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "title", "nodes", "edges"],
  "properties": {
    "schema": { "const": "observstory.system-map/v0" },
    "title": { "type": "string", "minLength": 1 },
    "purpose": { "type": "string" },
    "nodes": {
      "type": "array",
      "items": { "$ref": "#/$defs/node" }
    },
    "edges": {
      "type": "array",
      "items": { "$ref": "#/$defs/edge" }
    },
    "groups": {
      "type": "array",
      "items": { "$ref": "#/$defs/group" }
    },
    "views": {
      "type": "array",
      "items": { "$ref": "#/$defs/view" }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref"],
      "properties": {
        "ref": { "type": "string", "minLength": 1 },
        "label": { "type": "string" },
        "kind": { "enum": ["repository", "research", "experiment", "decision", "human"] }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "label"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9._:-]+$" },
        "kind": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "group": { "type": "string" },
        "status": {
          "enum": ["observed", "established", "candidate", "questioned", "deprecated"]
        },
        "basis": {
          "enum": ["human-declared", "repository-evidence", "research", "experiment", "inference"]
        },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence" }
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "kind"],
      "properties": {
        "id": { "type": "string" },
        "from": { "type": "string" },
        "to": { "type": "string" },
        "kind": { "type": "string", "minLength": 1 },
        "label": { "type": "string" },
        "status": {
          "enum": ["observed", "established", "candidate", "questioned", "deprecated"]
        },
        "basis": {
          "enum": ["human-declared", "repository-evidence", "research", "experiment", "inference"]
        },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence" }
        }
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "order": { "type": "integer" },
        "description": { "type": "string" }
      }
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "include": {
          "type": "array",
          "items": { "type": "string" }
        },
        "focus": { "type": "string" }
      }
    }
  }
}
